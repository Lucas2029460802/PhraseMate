# PhraseMate 环境变量（可选，复制为 .env 后填写）
# 日常使用请直接在应用「设置」里填写 API Key，无需本文件。

# 可选：OpenAI 兼容接口的 API Key（界面设置优先）
# PHRASEMATE_API_KEY=sk-your-key-here

# 可选：接口地址（默认 OpenAI；国内可用 DeepSeek / 通义等兼容地址）
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
PHRASEMATE_BASE_URL=https://api.openai.com/v1

# 可选：模型名
PHRASEMATE_MODEL=gpt-4o-mini

# 可选：仅浏览器模式时使用的监听地址（桌面模式会自动选空闲端口）
PHRASEMATE_ADDR=:8080

# 可选：SQLite 路径（运行时缓存；API 配置只存在这里）
PHRASEMATE_DB=data/phrasemate.db

# 可选：把生词同步到当前 Git 仓库的 data 分支（默认开启；0 关闭）
# 仅在本仓库内运行且已配置 origin 时生效。API Key 不会写入该分支。
# PHRASEMATE_GIT_SYNC=1
# PHRASEMATE_GIT_BRANCH=data

# 可选：单词先查免费词典，未命中再走 AI（默认开启）
PHRASEMATE_DICT_FIRST=true

# 可选：词典 API 地址（默认 Free Dictionary API）
# PHRASEMATE_DICT_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# 可选：设为 1 时不打开桌面窗口，只启动本地网页服务（Docker 镜像默认开启）
# PHRASEMATE_WEB=1

# 可选：桌面窗口开启开发者工具
# PHRASEMATE_DEBUG=1
