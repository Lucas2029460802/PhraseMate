# PhraseMate 环境变量（复制为 .env 后填写）

# 必填：OpenAI 兼容接口的 API Key
PHRASEMATE_API_KEY=sk-your-key-here

# 可选：接口地址（默认 OpenAI；国内可用 DeepSeek / 通义等兼容地址）
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
PHRASEMATE_BASE_URL=https://api.openai.com/v1

# 可选：模型名
PHRASEMATE_MODEL=gpt-4o-mini

# 可选：仅浏览器模式时使用的监听地址（桌面模式会自动选空闲端口）
PHRASEMATE_ADDR=:8080

# 可选：SQLite 路径
PHRASEMATE_DB=data/phrasemate.db

# 可选：设为 1 时不打开桌面窗口，只启动本地网页服务
# PHRASEMATE_WEB=1

# 可选：桌面窗口开启开发者工具
# PHRASEMATE_DEBUG=1
